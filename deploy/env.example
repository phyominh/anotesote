# /etc/pocketbase/env  (root:root, mode 600). Never commit the real file.

# Public base URL; OAuth discovery documents and tokens are bound to it.
PUBLIC_URL=https://ans.mhetsu.com

# Legacy secret-in-URL access at /mcp/<MCP_SECRET>. Remove the line to turn
# it off once Claude is connected through OAuth (/mcp).
# Generate with: openssl rand -hex 32
MCP_SECRET=replace-with-64-hex-chars

# Optional OAuth settings:
# OAUTH_REDIRECT_URIS=https://example.com/callback   # extra allowed redirect URIs (comma-separated)
# OAUTH_ALLOW_LOOPBACK=1                             # allow http://localhost redirects (MCP Inspector)
# OAUTH_CIMD_HOSTS=example.com                       # extra hosts for client ID metadata documents
# OAUTH_DISABLED=1                                   # turn OAuth off entirely
