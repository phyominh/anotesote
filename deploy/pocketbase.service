# /etc/systemd/system/pocketbase.service
# install.sh fills in @SERVE_ARGS@: --http=127.0.0.1:8090 behind nginx or
# another proxy (and drops the capabilities below), or the bare domain in
# standalone mode, where PocketBase serves :80/:443 with Let's Encrypt.
[Unit]
Description=PocketBase (study KB + MCP)
After=network-online.target
Wants=network-online.target

[Service]
User=pocketbase
Group=pocketbase
WorkingDirectory=/opt/pocketbase
EnvironmentFile=/etc/pocketbase/env
ExecStart=/opt/pocketbase/pocketbase serve @SERVE_ARGS@
Restart=on-failure
RestartSec=5
LimitNOFILE=4096

# Standalone mode binds :80 and :443 as a non-root user.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening: only pb_data is writable.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/opt/pocketbase/pb_data

[Install]
WantedBy=multi-user.target
